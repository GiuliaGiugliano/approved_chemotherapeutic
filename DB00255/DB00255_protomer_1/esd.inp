! B3LYP def2-TZVP CPCM(water) TightSCF ESD(ISC)
%PAL NPROCS 16 END
%maxcore 16000

%TDDFT
   NRoots   5
   SRoot    1        # stato iniziale = S1
   TRoot    1        # stato finale = T1
   TRootSSL  1       # sottolivello tripletto: M_S = +1
   DoSOC    TRUE
END

%ESD
   ISCISHESS   "s1.hess"   # Hessiano S1
   ISCFSHESS   "freq.hess"   # Hessiano T1
   UseJ        TRUE
   DoHT        TRUE        # Herzberg–Teller effect (metti FALSE se vuoi trascurarlo)
   Temp        298         # Temperatura in K
END

* xyzfile 0 1 opt_t1.xyz

$NEW_JOB

! B3LYP def2-TZVP CPCM(water) TightSCF ESD(ISC)
%PAL NPROCS 16 END
%maxcore 16000

%TDDFT
   NRoots   5
   SRoot    1
   TRoot    1
   TRootSSL  0       # sottolivello tripletto: M_S = 0
   DoSOC    TRUE
END

%ESD
   ISCISHESS   "s1.hess"
   ISCFSHESS   "freq.hess"
   UseJ        TRUE
   DoHT        TRUE
   Temp        298
END

* xyzfile 0 1 opt_t1.xyz

$NEW_JOB

! B3LYP def2-TZVP CPCM(water) TightSCF ESD(ISC)
%PAL NPROCS 16 END
%maxcore 16000

%TDDFT
   NRoots   5
   SRoot    1
   TRoot    1
   TRootSSL -1       # sottolivello tripletto: M_S = –1
   DoSOC    TRUE
END

%ESD
   ISCISHESS   "s1.hess"
   ISCFSHESS   "freq.hess"
   UseJ        TRUE
   DoHT        TRUE
   Temp        298
END

* xyzfile 0 1 opt_t1.xyz

